#!/usr/bin/env bash
# Fetch one binary feed (GTFS-Realtime protobuf) and emit it as base64 on
# stdout, so QML's text-only stdout collector can carry it. The API key is
# never on a command line: the curl config carrying the Authorization header
# arrives on stdin and flows through tfnsw-bounded (fd 4) straight into curl's
# `-K -`. Only 2xx bodies are emitted; a 3xx is not data. Output is capped by
# tfnsw-bounded.
set -euo pipefail
url=$1
case "$url" in https://api.transport.nsw.gov.au/*) ;; *) exit 64 ;; esac
limit=${TFNSW_MAX_BYTES:-4194304}
exec env TFNSW_MAX_BYTES="$limit" "$(dirname "$0")/tfnsw-bounded" bash -c '
  set -euo pipefail
  dir=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/tfnsw-fetch.XXXXXX")
  trap "rm -rf \"$dir\"" EXIT
  code=$(curl -sS --proto =https --max-filesize 3145728 --max-time 20 -K - \
    -o "$dir/body" -w "%{http_code}" "$1")
  case "$code" in 2[0-9][0-9]) ;; *) exit 65 ;; esac
  base64 -w0 < "$dir/body"
' _ "$url"
